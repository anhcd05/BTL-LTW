    "cards":  [
                  {
                      "dot":  "cyan",
                      "title":  "¹ URL có hạn 5 phút",
                      "items":  [
                                    "GET /api/v1/tracks/:id/playback nhận cả khách lẫn tài khoản. Bài phải PUBLISHED, READY, chưa xóa, tác giả còn hoạt động và bản phát đã xác minh khớp sourceVersion.",
                                    "API tự ký URL cho đúng phiên bản đối tượng. Trình duyệt đọc byte qua cổng media 9443. Với thời lượng hợp lệ, API cấp thêm token nghe có hạn 15 phút cho đúng người, bài và phiên bản nguồn."
                                ]
                  },
                  {
                      "dot":  "emerald",
                      "title":  "² Khi nào trình phát gửi lượt nghe?",
                      "items":  [
                                    "Ngưỡng bằng giá trị nhỏ hơn giữa 30 giây và một nửa thời lượng bài. Trình phát chỉ cộng thời gian âm thanh thực sự tiến, bỏ qua khoảng chờ, tạm dừng và phần nhảy qua khi tua.",
                                    "POST /api/v1/tracks/:id/listens gửi token. API đối chiếu danh tính, thời gian đã trôi và nguồn hiện hành trước khi ghi."
                                ]
                  },
                  {
                      "dot":  "violet",
                      "title":  "³ Cùng người, bài và nguồn trong 30 phút",
                      "items":  [
                                    "Lượt đầu đủ điều kiện tăng tổng của bài. Với khách, hệ thống lưu mốc chống trùng theo mã băm của danh tính trình duyệt.",
                                    "Tài khoản có thêm lịch sử cá nhân. Khi phát lại trong cửa sổ chống trùng, hệ thống chỉ cập nhật lần nghe gần nhất của tài khoản."
                                ]
                  }
              ]
